              {
                "label": "webm",
                "value": "webm"
              },
              {
                "label": "mkv",
                "value": "mkv"
              },
              {
                "label": "m4a",
                "value": "m4a"
              },
              {
                "label": "mp3",
                "value": "mp3"
              },
              {
                "label": "opus",
                "value": "opus"
              }
            ],
            "advanced": true,
            "help": "Video: mp4/webm/mkv. Audio: m4a/mp3/opus. Omit for the API default."
          },
