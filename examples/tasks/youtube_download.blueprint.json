            "name": "uploadMetadata",
            "type": "boolean",
            "label": "Upload metadata",
            "required": true,
            "default": false,
            "advanced": true
          },
          {
            "name": "startAt",
            "type": "text",
            "label": "Clip start",
            "validate": {
              "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]$"
            },
            "advanced": true,
            "help": "HH:MM:SS, no later than 12:00:00."
          },
          {
            "name": "endAt",
            "type": "text",
            "label": "Clip end",
            "validate": {
              "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]$"
            },
            "advanced": true,
            "help": "Must be later than the start and no later than 12:00:00."
          }
        ]
