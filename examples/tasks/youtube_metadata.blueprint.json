            "label": "Include chapters",
            "required": true,
            "default": true
          },
          {
            "name": "includeFormats",
            "type": "boolean",
            "label": "Include formats",
            "required": true,
            "default": false
          }
        ]
      }
    }
  ],
  "metadata": {
