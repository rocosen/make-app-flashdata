{
  "name": "Inspect YouTube video metadata and chapters",
  "flow": [
    {
      "id": 1,
      "module": "app#flashdata-g6iv9y:getVideoMetadata",
      "version": 1,
      "parameters": {},
      "mapper": {
        "videoId": "jNQXAC9IVRw",
        "includeChapters": true,
        "includeFormats": false
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:app#flashdata-g6iv9y",
            "label": "Connection",
