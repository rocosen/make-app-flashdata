[
  {
    "name": "videoId",
    "type": "text",
    "label": "Video ID",
    "required": true,
    "validate": {
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "help": "Enter the 11-character YouTube video ID, not the full URL."
  },
  {
    "name": "downloadType",
    "type": "select",
    "label": "Download type",
    "options": [
      {
        "label": "audio_video",
        "value": "audio_video"
      },
      {
        "label": "video",
        "value": "video"
      },
      {
        "label": "audio",
        "value": "audio"
      }
    ],
    "required": true,
    "default": "audio_video"
  },
