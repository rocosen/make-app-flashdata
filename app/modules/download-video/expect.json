  },
  {
    "name": "fps",
    "type": "text",
    "label": "Frame rate constraint",
    "validate": {
      "pattern": "^(>=|<=|==)([1-9][0-9]?|1[0-9][0-9]|2[0-3][0-9]|240)$"
    },
    "advanced": true
  },
  {
    "name": "audioLanguage",
    "type": "select",
    "label": "Audio language",
    "options": [
      {
        "label": "default",
        "value": "default"
      },
      {
        "label": "original",
        "value": "original"
      }
    ],
    "advanced": true,
    "help": "Audio or combined output only; leave empty for video-only. Defaults to the original service choice."
  },
  {
    "name": "audioQuality",
    "type": "select",
    "label": "Audio bitrate",
    "options": [
      {
        "label": "best",
        "value": "best"
      },
      {
        "label": "320",
        "value": "320"
      },
      {
        "label": "256",
        "value": "256"
      },
      {
        "label": "192",
        "value": "192"
      },
      {
        "label": "128",
        "value": "128"
      }
    ],
    "advanced": true,
    "help": "Audio-only downloads; values are strings in kbps."
  },
  {
    "name": "outputFormat",
    "type": "select",
    "label": "Output format",
    "options": [
      {
        "label": "mp4",
        "value": "mp4"
      },
      {
        "label": "webm",
        "value": "webm"
      },
      {
        "label": "mkv",
        "value": "mkv"
      },
      {
        "label": "m4a",
        "value": "m4a"
      },
      {
        "label": "mp3",
        "value": "mp3"
      },
      {
        "label": "opus",
        "value": "opus"
      }
    ],
    "advanced": true,
    "help": "Video: mp4/webm/mkv. Audio: m4a/mp3/opus. Omit for the API default."
  },
  {
    "name": "ytDlpFormat",
    "type": "text",
    "label": "Advanced format selector",
    "validate": {
      "min": 1,
      "max": 1024
    },
    "advanced": true,
    "help": "Overrides video quality, FPS and audio language; clipping and output format still apply."
  },
  {
    "name": "uploadMetadata",
    "type": "boolean",
    "label": "Upload metadata",
    "required": true,
    "default": false,
    "advanced": true
  },
  {
    "name": "startAt",
    "type": "text",
    "label": "Clip start",
    "validate": {
      "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]$"
    },
    "advanced": true,
    "help": "HH:MM:SS, no later than 12:00:00."
  },
  {
    "name": "endAt",
    "type": "text",
    "label": "Clip end",
    "validate": {
      "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]$"
    },
    "advanced": true,
    "help": "Must be later than the start and no later than 12:00:00."
  }
]
