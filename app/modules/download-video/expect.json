        "validate": {
          "min": 1,
          "max": 1024
        },
        "required": true
      },
      {
        "name": "object_prefix",
        "type": "text",
        "label": "Object prefix",
        "validate": {
          "min": 1,
          "max": 512
        },
        "help": "Example archive/YYYYMMDD. Use a prefix, not part of the bucket name."
      }
    ],
    "help": "Your writable destination is required. Storage credentials are sent to FlashData to deliver this job. Never put them in public templates. Storage provider charges are separate."
