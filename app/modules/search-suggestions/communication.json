{
  "url": "/v1/queries/realtime",
  "method": "POST",
  "type": "json",
  "body": {
    "source": "youtube_suggestions",
    "query": "{{parameters.query}}",
    "params": {
      "language": "{{parameters.language}}",
      "region": "{{parameters.region}}"
    }
  },
  "response": {
    "valid": {
      "condition": "{{statusCode === 200 && !body.error && (!body.status || body.status === 'done' || body.status === 'completed') && (!body.job || body.job.status !== 'failed') && body.results}}",
      "type": "RuntimeError",
      "message": "[{{statusCode}}] {{ifempty(body.message, ifempty(body.detail, 'FlashData request failed. Check the endpoint, input and account permissions.'))}}{{if(body.field, ' Field: ', '')}}{{ifempty(body.field, '')}} For an uncertain query, inspect Jobs before submitting again."
    },
    "output": {
      "suggestion": "{{item}}"
    },
    "iterate": "{{get(body.results, '1')}}",
    "limit": "{{parameters.limit}}"
  },
  "followRedirect": false,
  "followAllRedirect": false
}
